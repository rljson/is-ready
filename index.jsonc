{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/is-ready",

  // 1-2 sentence summary about this repo.
  "summary": "IsReady: a readiness flag with a promise; resolve() fulfils every waiting promise, reset() sets the flag back.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "wait until an async init is done",
    "state, promise, resolve, reset"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "io": "IsReady: isReady() of IoMem",
      "io-sqlite-node": "IsReady: isReady() of IoSqliteNode",
      "io-mssql": "IsReady: isReady() of IoMssql"
    }
  }
}
